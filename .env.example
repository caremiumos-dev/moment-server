# Copy to .env and change every value marked CHANGE ME.
# docker compose reads this file automatically.

# Build-time package mirrors.  APT_MIRROR accepts either a host or a full
# http(s) base url.  PIP_INDEX_URL may be left empty to use pypi.org.
# Aliyun examples:
#   APT_MIRROR=mirrors.aliyun.com
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# Session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MOMENT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Bootstrap administrator, only used when the database has no users yet.
MOMENT_ADMIN_USERNAME=admin
MOMENT_ADMIN_PASSWORD=CHANGE_ME
MOMENT_ADMIN_WATCH_ID=admin

# Insert the default mood/state templates and recommended topics the first
# time the database is created.  Set to false if you want an empty server.
MOMENT_SEED_DEFAULTS=true

# Set to true once the dashboard is served over https, so the session cookie
# is never sent over plain http.
MOMENT_SECURE_COOKIES=false

# Public address the watch uses to download pictures.  Leave empty to reuse
# the host from each request (correct for direct LAN access).
# MOMENT_PUBLIC_BASE_URL=https://moment.example.com

# Number of reverse proxies in front of the container.  Leave 0 for direct
# access; set 1 for a single nginx/Caddy/Traefik hop.
MOMENT_PROXY_COUNT=0

# Logging.
MOMENT_LOG_LEVEL=INFO
MOMENT_LOG_REQUESTS=true

# Upload limit in bytes (default 64 MiB).
MOMENT_MAX_UPLOAD_BYTES=67108864
